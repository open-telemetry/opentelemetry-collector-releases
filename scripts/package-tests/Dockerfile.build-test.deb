# Installs, reinstalls and removes a deb package as part of an image build,
# where systemd is installed but not running as PID 1.
FROM debian:13@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6

ARG PKG
ARG DISTRO

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y systemd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/tmp/*

COPY ${PKG} /tmp/

# install
RUN dpkg -i /tmp/${PKG} && \
    test -L /etc/systemd/system/multi-user.target.wants/${DISTRO}.service
# reinstall to exercise the upgrade path of the preremove and postinstall scripts
RUN dpkg -i /tmp/${PKG} && \
    test -L /etc/systemd/system/multi-user.target.wants/${DISTRO}.service
# uninstall
RUN dpkg -r ${DISTRO} && \
    ! test -L /etc/systemd/system/multi-user.target.wants/${DISTRO}.service
