[Unit]
Description=OpenTelemetry Collector Prometheus
After=network.target

[Service]
EnvironmentFile=/etc/otelcol-prometheus/otelcol-prometheus.conf
ExecStart=/usr/bin/otelcol-prometheus $OTELCOL_OPTIONS
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=on-failure
Type=simple
User=otelcol-prometheus
Group=otelcol-prometheus

NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true

[Install]
WantedBy=multi-user.target
